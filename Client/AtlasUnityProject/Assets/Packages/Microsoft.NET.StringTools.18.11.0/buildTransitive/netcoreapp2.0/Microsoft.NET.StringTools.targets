<Project InitialTargets="NETStandardCompatError_Microsoft_NET_StringTools_net11_0">
  <Target Name="NETStandardCompatError_Microsoft_NET_StringTools_net11_0"
          Condition="'$(SuppressTfmSupportBuildWarnings)' == ''">
    <Warning Text="Microsoft.NET.StringTools 18.11.0-1.26512.6 doesn't support $(TargetFramework) and has not been tested with it. Consider upgrading your TargetFramework to net11.0 or later. You may also set &lt;SuppressTfmSupportBuildWarnings&gt;true&lt;/SuppressTfmSupportBuildWarnings&gt; in the project file to ignore this warning and attempt to run in this unsupported configuration at your own risk." />
  </Target>
</Project>
