<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- BATTLE_TOKEN_SECRET/INTERNAL_API_SECRETはdotnet user-secretsで設定する(Development環境で自動的に読み込まれる)。
         手順はリポジトリ直下のDEVELOPMENT.md参照 -->
    <UserSecretsId>atlas-battleserver</UserSecretsId>
    <!-- Tests/・BattleCore/・BattleContracts/・BattleBot/は別プロジェクトのため取り込まない -->
    <DefaultItemExcludes>$(DefaultItemExcludes);Tests/**;BattleCore/**;BattleContracts/**;BattleBot/**</DefaultItemExcludes>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="MagicOnion.Server" Version="7.11.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- Shared/BattleCoreはBattleCore/Atlas.BattleCore.csproj(Unityパッケージの外に置いたcsproj)で
         DLLとしてビルドして参照する(Unityのasmdefと同じくinternalの境界を保つため)。 -->
    <ProjectReference Include="BattleCore\Atlas.BattleCore.csproj" />
    <!-- Shared/BattleContracts(Clientと共有する通信契約)も同じ方式でDLLとして参照する。 -->
    <ProjectReference Include="BattleContracts\Atlas.BattleContracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- MasterData/{AesCrypto,MasterDataLoader}.csはmaster-data-pipelineの
         copy-loaderで配置済みだが、MasterMemoryResolver等を生成するModels/Enums
         (copy-models)がまだ配置されておらずビルドできないため、それらを配置するまで
         コンパイル対象から除外する(Shared/docs/progress.md参照)。 -->
    <Compile Remove="MasterData/**/*.cs" />
  </ItemGroup>

</Project>
