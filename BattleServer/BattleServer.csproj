  <ItemGroup>
    <PackageReference Include="MagicOnion.Server" Version="7.11.0" />
    <PackageReference Include="Microsoft.IdentityModel.JsonWebTokens" Version="8.23.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Shared\BattleCore\Atlas.BattleCore.csproj" />
  </ItemGroup>

  <ItemGroup>
