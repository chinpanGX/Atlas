<Project Sdk="Microsoft.NET.Sdk">

  <!-- Atlas.BattleCore(ダメージ計算・ターン処理)のテスト。BattleCoreを実際に動かすのはBattleServerだけなので、
       Unityではなくここで回す(dotnet test BattleServer.slnx で BattleServer のテストと一緒に走る)。 -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <IsPackable>false</IsPackable>
    <RootNamespace>Atlas.BattleCore.Tests</RootNamespace>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.14.1" />
    <PackageReference Include="NUnit" Version="3.14.0" />
    <PackageReference Include="NUnit3TestAdapter" Version="4.6.0" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\BattleCore\Atlas.BattleCore.csproj" />
  </ItemGroup>

</Project>
