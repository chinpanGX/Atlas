# Server/.env の見本。コピーして .env を作り、シークレットは openssl rand -hex 32 で生成した値に変える
DATABASE_URL=mysql://root@127.0.0.1:3306/atlas_dev
SERVER_ADDR=127.0.0.1:3000
BATTLE_SERVER_URL=http://127.0.0.1:5000
# BattleServer と同じ値にする(BATTLE_TOKEN_SECRET は32バイト以上)
BATTLE_TOKEN_SECRET=
INTERNAL_API_SECRET=

# ログ。無ければ JSON・info・atlas-api・local で出し、ゲームログは DB の game_logs テーブルに書く
# 開発中にターミナルで読みやすくしたいときは LOG_FORMAT=text
#LOG_FORMAT=text
#RUST_LOG=info,sqlx::query=debug
#LOG_FIELD_NAMES=standard
#OTEL_SERVICE_NAME=atlas-api
#APP_ENV=local
#GAME_LOG_SINK=database
