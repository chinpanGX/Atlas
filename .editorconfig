root = true

# C#の命名ルール(Client・BattleServer・Shared/BattleCore・Shared/BattleContracts共通)。
# Supplementの.editorconfigと同じルール(Riderの設定を書き出したもの)。
# - private のインスタンスフィールド・static フィールドは camelCase(アンダースコアを付けない)
# - private の const・static readonly は PascalCase
# 生成物(先頭に<auto-generated/>があるファイル)はツールが自動で対象外にする。
[*.cs]
# 命名ルールの違反(IDE1006)を、IDEだけでなくdotnet build(EnforceCodeStyleInBuild)でも警告にする
